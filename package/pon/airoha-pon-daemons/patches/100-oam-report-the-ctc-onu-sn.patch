+    /// The vendor code reported to the OLT: the configured vendor ID, else the
+    /// vendor bytes of the serial number the line registers with, else the
+    /// default.
+    pub fn vendor(&self) -> Vec<u8> {
+        match self.active_serial_number {
+            Some(serial) if !self.vendor_id_configured => serial[..4].to_vec(),
+            _ => fixed_width(&self.vendor_id, 4),
+        }
+    }
+
+    /// The CTC ONU SN attribute, see `OnuSnFormat::Ctc`. `extended` adds the
+    /// extended ONU model that CTC 3.0 appends.
+    pub fn ctc_onu_sn(&self, source_mac: [u8; 6], extended: bool) -> Vec<u8> {
+        let mut value = self.vendor();
+        value.extend_from_slice(&fixed_width(&self.model, 4));
+        value.extend_from_slice(&source_mac);
+        value.extend_from_slice(&fixed_width(&self.hardware_version, 8));
+        value.extend_from_slice(&fixed_width(&self.software_version, 16));
+        if extended {
+            value.extend_from_slice(&fixed_width(&self.equipment_id, 16));
+        }
+        value
+    }
 }
 
