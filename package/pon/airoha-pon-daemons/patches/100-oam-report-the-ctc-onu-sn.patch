+/// Pick up the serial number the line currently registers with, so the ONU SN
+/// carries it and an unset vendor ID follows it. A failed read keeps the last
+/// value.
+fn refresh_active_serial(interface: &str, config: &mut OamConfig, status: &StatusHub) {
+    let serial = match active_serial_number(interface) {
+        Ok(serial) => serial,
+        Err(_) => return,
+    };
+    if serial == config.active_serial_number {
+        return;
+    }
+    config.active_serial_number = serial;
+    let message = match serial {
+        Some(serial) => format!(
+            "ONU serial {}{:02X}{:02X}{:02X}{:02X}, vendor {}",
+            String::from_utf8_lossy(&serial[..4]),
+            serial[4],
+            serial[5],
+            serial[6],
+            serial[7],
+            String::from_utf8_lossy(&config.vendor()),
+        ),
+        None => "ONU serial cleared".to_owned(),
+    };
+    status.record_event("identity", message);
+}
