+/// How the CTC ONU SN attribute (branch 0xC7, leaf 0x0001) is encoded.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OnuSnFormat {
+    /// The CTC layout: vendor ID (4), ONU model (4), ONU ID, which is the MAC
+    /// address (6), hardware version (8) and software version (16), followed
+    /// from CTC 3.0 on by the extended ONU model (16).
+    Ctc,
+    /// The 8-byte ONU serial number alone, which a Huawei OLT was reported to
+    /// accept where it rejected the CTC layout.
