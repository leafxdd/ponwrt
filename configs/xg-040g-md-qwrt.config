# Nokia XG-040G-MD (UBI) with the QWRT R26.09.30 feature set: proxy,
# storage sharing and the Lean LuCI apps. firewall4/nftables stays in place.
#
#   ./scripts/kconfig.pl + + configs/an7581.config configs/release.config \
#     configs/xg-040g-md-qwrt.config > .config
#   make defconfig

# Only build the XG-040G-MD UBI image.
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5382a is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct-usb-sfp is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu-usb-sfp is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_gemtek_xg2010g is not set
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi-usb-sfp is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-tf-ubi is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_unionman_ung00a is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn504xg-d is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn515xg-d is not set

# Proxy: OpenClash and SSR-Plus with Xray, ShadowsocksR and ChinaDNS-NG.
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-ssr-plus=y
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NONE_V2RAY is not set
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y
# helloworld hashes git sources for Lean's tarball format, which PonWrt's
# git archive based download does not reproduce, so its mihomo package fails
# to download. OpenClash fetches its own mihomo core for Clash subscriptions.
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Mihomo is not set

# Storage sharing: Samba 4, FTP, DLNA and automatic USB disk mounting.
CONFIG_PACKAGE_autosamba=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-vsftpd=y
# DLNA comes from xupnpd, as on QWRT. QWRT's luci-app-xupnpd is not public,
# so it is configured through xupnpd's own web UI on port 4044.
# minidlna is not used: it needs libffmpeg, which can only build here with
# libdrm disabled (libdrm needs the missing video-support package), and the
# feed's V4L2 m2m deinterlace patch then fails to build without libdrm.
CONFIG_PACKAGE_xupnpd=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# Lean LuCI apps from package/lean.
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-theme-design=y
